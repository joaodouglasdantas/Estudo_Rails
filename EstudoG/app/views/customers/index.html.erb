<h1>Customers</h1>
<%= link_to "Adicionar cliente", new_customer_path %>

<% @customers.each do |customer| %>
  <table class="table">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Telefone</th>
        <th>Endereço</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><%= customer.name %></td>
        <td><%= customer.phone %></td>
        <td>
          <% customer.addresses.each do |address| %>
            <p><%= address.street %>, <%= address.number %>, <%= address.city %></p>
          <% end %>
        </td>
      </tr>
    </tbody>
  </table>
<% end %>