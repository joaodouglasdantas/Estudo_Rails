<h1>Customers</h1>
<%= link_to "Adicionar cliente", new_customer_path %>

<% @customers.each do |customer| %>
  <table class="table">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Telefone</th>
        <th>Endereço</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <!-- Nome -->
        <% if customer.name.present? %>
          <td><%= customer.name %></td>
        <% else %>
          <td> Nada cadastrado </td>
        <% end %>

        <!-- Telefone -->
        <% if customer.phone.present? %>
          <td><%= customer.phone %></td>
        <% else %>
          <td> Nada cadastrado </td>
        <% end %>

        <!-- Endereço -->
        <% if customer.addresses.any? %>
          <td>
            <% customer.addresses.each do |address| %>
              <%= address.street.presence || "Não cadastrado" %>,
              <%= address.number.presence || "Não cadastrado" %>,
              <%= address.city.presence || "Não cadastrado" %>
            <% end %>
          </td>
        <% else %>
          <td> Nada cadastrado </td>
        <% end %>
      </tr>
    </tbody>
  </table>
<% end %>